# Server-only Day 10 placeholders. Never commit live values.
NEXT_SAVE_SUPABASE_URL=https://YOUR_TEST_PROJECT.supabase.co
NEXT_SAVE_SUPABASE_ANON_KEY=YOUR_TEST_PROJECT_ANON_KEY
NEXT_SAVE_SUPABASE_WRITE_ENABLED=false

# Server-only Day 13 placeholders. Test mode creates a fictional session only.
# Generate a local value of at least 32 random characters; never commit it.
NEXT_SAVE_AUTH_TEST_MODE=false
NEXT_SAVE_AUTH_SESSION_SECRET=YOUR_LOCAL_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Day 13 Supabase Auth public browser configuration. The Google OAuth client
# secret belongs only in the Supabase dashboard, never in this repository.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_APPROVED_TEST_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_APPROVED_TEST_PROJECT_PUBLISHABLE_KEY
